{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrialalgebra.com/schemas/lonis.block/intent/v1",
  "x-lonis-protocol-version": "lonis.block/v1",
  "title": "lonis.block intent payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "data"],
  "properties": {
    "kind": { "const": "intent" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement"],
      "properties": {
        "statement": { "type": "string", "maxLength": 4096 },
        "constraints": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "maxLength": 1024 }
        }
      }
    }
  }
}
