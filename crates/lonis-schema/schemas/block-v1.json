{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrialalgebra.com/schemas/lonis.block/v1",
  "x-lonis-protocol-version": "lonis.block/v1",
  "title": "lonis.block envelope (all 14 seed kinds)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attribution",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "lonis.block/v1"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool_version": {
          "type": "string",
          "maxLength": 256
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "maxLength": 256
            },
            "reasons": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        },
        "replay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "replayable"
          ],
          "properties": {
            "replayable": {
              "type": "boolean"
            },
            "required_hashes": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 256
              }
            },
            "reasons": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        },
        "project_hash": {
          "type": "string",
          "maxLength": 128
        },
        "input_hash": {
          "type": "string",
          "maxLength": 128
        },
        "plan_hash": {
          "type": "string",
          "maxLength": 128
        },
        "result_hash": {
          "type": "string",
          "maxLength": 128
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "provenance"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "maxLength": 1024
        },
        "viewpoint": {
          "type": "string",
          "maxLength": 1024
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "when",
            "producer"
          ],
          "properties": {
            "when": {
              "type": "string",
              "maxLength": 64
            },
            "where": {
              "type": "string",
              "maxLength": 4096
            },
            "producer": {
              "type": "string",
              "maxLength": 1024
            }
          }
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_items": {
          "type": "integer",
          "minimum": 0
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_length": {
          "type": "integer",
          "minimum": 0
        },
        "timeout_millis": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "#/$defs/message"
        },
        {
          "$ref": "#/$defs/question"
        },
        {
          "$ref": "#/$defs/answer"
        },
        {
          "$ref": "#/$defs/decision"
        },
        {
          "$ref": "#/$defs/action"
        },
        {
          "$ref": "#/$defs/assumption"
        },
        {
          "$ref": "#/$defs/summary"
        },
        {
          "$ref": "#/$defs/evidence"
        },
        {
          "$ref": "#/$defs/definition"
        },
        {
          "$ref": "#/$defs/capability"
        },
        {
          "$ref": "#/$defs/intent"
        },
        {
          "$ref": "#/$defs/plan"
        },
        {
          "$ref": "#/$defs/result"
        },
        {
          "$ref": "#/$defs/outcome"
        },
        {
          "$ref": "#/$defs/extension"
        }
      ]
    }
  },
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "data"
      ],
      "properties": {
        "kind": {
          "const": "message"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "content"
          ],
          "properties": {
            "role": {
              "type": "string",
              "maxLength": 256
            },
            "content": {
              "type": "string",
              "maxLength": 16384
            },
            "reply_to": {
              "type": "string",
              "maxLength": 4096
            }
          }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "data"
      ],
      "properties": {
        "kind": {
          "const": "question"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 4096
            },
            "context": true,
            "options": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 1024
              }
            }
          }
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "data"
      ],
      "properties": {
        "kind": {
          "const": "answer"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "question": {
              "type": "string",
              "maxLength": 4096
            },
            "text": {
              "type": "string",
              "maxLength": 16384
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "data"
      ],
      "properties": {
        "kind": {
          "const": "decision"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statement"
          ],
          "properties": {
            "statement": {
              "type": "string",
              "maxLength": 4096
            },
            "rationale": {
              "type": "string",
              "maxLength": 16384
            },
            "alternatives": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 1024
              }
            }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "data"
      ],
      "properties": {
        "kind": {
          "const": "action"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verb",
            "status"
          ],
          "properties": {
            "verb": {
              "type": "string",
              "maxLength": 256
            },
            "target": {
              "type": "string",
              "maxLength": 4096
            },
            "parameters": true,
            "status": {
              "enum": [
                "pending",
                "running",
                "completed",
                "failed"
              ]
            }
          }
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "data"
      ],
      "properties": {
        "kind": {
          "const": "assumption"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statement",
            "status"
          ],
          "properties": {
            "statement": {
              "type": "string",
              "maxLength": 4096
            },
            "status": {
              "enum": [
                "open",
                "validated",
                "refuted"
              ]
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "data"
      ],
      "properties": {
        "kind": {
          "const": "summary"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "of": {
              "type": "array",
              "maxItems": 1024,
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "text": {
              "type": "string",
              "maxLength": 16384
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "data"
      ],
      "properties": {
        "kind": {
          "const": "evidence"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "summary"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "maxLength": 256
            },
            "summary": {
              "type": "string",
              "maxLength": 4096
            },
            "source": {
              "type": "string",
              "maxLength": 4096
            },
            "hash": {
              "type": "string",
              "maxLength": 128
            },
            "weight": {
              "type": "number"
            }
          }
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "data"
      ],
      "properties": {
        "kind": {
          "const": "definition"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 1024
            },
            "name": {
              "type": "string",
              "maxLength": 512
            },
            "kind": {
              "type": "string",
              "maxLength": 128
            },
            "path": {
              "type": "string",
              "maxLength": 4096
            },
            "signature": {
              "type": "string",
              "maxLength": 4096
            },
            "summary": {
              "type": "string",
              "maxLength": 4096
            },
            "docs": {
              "type": "string",
              "maxLength": 65536
            },
            "overlay": true
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "data"
      ],
      "properties": {
        "kind": {
          "const": "capability"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "description",
            "input_schema",
            "output_schema",
            "determinism",
            "side_effects",
            "cost"
          ],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 1024
            },
            "description": {
              "type": "string",
              "maxLength": 4096
            },
            "input_schema": {
              "type": "string",
              "maxLength": 1024
            },
            "output_schema": {
              "type": "string",
              "maxLength": 1024
            },
            "determinism": {
              "enum": [
                "deterministic",
                "bounded-nondeterministic",
                "nondeterministic"
              ]
            },
            "side_effects": {
              "enum": [
                "none",
                "read-only",
                "writes-filesystem",
                "mutates-external",
                "network",
                "destructive"
              ]
            },
            "cost": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "capabilities": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "data"
      ],
      "properties": {
        "kind": {
          "const": "intent"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statement"
          ],
          "properties": {
            "statement": {
              "type": "string",
              "maxLength": 4096
            },
            "constraints": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 1024
              }
            }
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "data"
      ],
      "properties": {
        "kind": {
          "const": "plan"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "steps"
          ],
          "properties": {
            "goal": {
              "type": "string",
              "maxLength": 4096
            },
            "steps": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "$ref": "#/$defs/plan_step"
              }
            },
            "prerequisite_order": {
              "type": "array",
              "maxItems": 1024,
              "items": {
                "type": "string",
                "maxLength": 1024
              }
            },
            "normalization": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "normalized",
                "max_rewrites"
              ],
              "properties": {
                "normalized": {
                  "type": "boolean"
                },
                "max_rewrites": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                },
                "trace": {
                  "type": "array",
                  "maxItems": 4096,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "before",
                      "after"
                    ],
                    "properties": {
                      "before": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/plan_step"
                        }
                      },
                      "after": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/plan_step"
                        }
                      }
                    }
                  }
                }
              }
            },
            "plan_hash": {
              "type": "string",
              "maxLength": 128
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "data"
      ],
      "properties": {
        "kind": {
          "const": "result"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "output"
          ],
          "properties": {
            "output": true,
            "score": {
              "type": "number"
            },
            "evidence": {
              "type": "array",
              "maxItems": 1024,
              "items": {
                "$ref": "#/$defs/evidence_data"
              }
            },
            "validated_assumptions": {
              "type": "array",
              "maxItems": 1024,
              "items": {
                "type": "string",
                "maxLength": 1024
              }
            },
            "refuted_assumptions": {
              "type": "array",
              "maxItems": 1024,
              "items": {
                "type": "string",
                "maxLength": 1024
              }
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "operations",
                "nodes",
                "iterations",
                "bytes"
              ],
              "properties": {
                "operations": {
                  "type": "integer",
                  "minimum": 0
                },
                "nodes": {
                  "type": "integer",
                  "minimum": 0
                },
                "iterations": {
                  "type": "integer",
                  "minimum": 0
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "duration_micros": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "data"
      ],
      "properties": {
        "kind": {
          "const": "outcome"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "kind",
            "message"
          ],
          "properties": {
            "status": {
              "enum": [
                "success",
                "partial",
                "no_match",
                "insufficient_evidence",
                "blocked",
                "error"
              ]
            },
            "kind": {
              "type": "string",
              "maxLength": 256
            },
            "message": {
              "type": "string",
              "maxLength": 4096
            },
            "details": true,
            "exit_code": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "data"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "maxLength": 256,
          "not": {
            "enum": [
              "message",
              "question",
              "answer",
              "decision",
              "action",
              "assumption",
              "summary",
              "evidence",
              "definition",
              "capability",
              "intent",
              "plan",
              "result",
              "outcome"
            ]
          }
        },
        "data": true
      }
    },
    "plan_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "detail"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "maxLength": 256
        },
        "detail": true
      }
    },
    "evidence_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "maxLength": 256
        },
        "summary": {
          "type": "string",
          "maxLength": 4096
        },
        "source": {
          "type": "string",
          "maxLength": 4096
        },
        "hash": {
          "type": "string",
          "maxLength": 128
        },
        "weight": {
          "type": "number"
        }
      }
    }
  }
}
