{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrialalgebra.com/schemas/lonis.block/message/v1",
  "x-lonis-protocol-version": "lonis.block/v1",
  "title": "lonis.block message payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "data"],
  "properties": {
    "kind": { "const": "message" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "role": { "type": "string", "maxLength": 256 },
        "content": { "type": "string", "maxLength": 16384 },
        "reply_to": { "type": "string", "maxLength": 4096 }
      }
    }
  }
}
